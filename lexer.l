%{
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "parser.tab.h"  // Will be generated by Bison

int line_num = 1;
int column_num = 1;
void count_column();
void count_line();
void handle_error();
%}

%option noyywrap

/* Regular Definitions */
DIGIT       [0-9]
INTEGER     {DIGIT}+
FLOAT       {DIGIT}+"."{DIGIT}+
DOUBLE      {DIGIT}+"."{DIGIT}+([eE][+-]?{DIGIT}+)?
LETTER      [a-zA-Z]
ID          {LETTER}({LETTER}|{DIGIT}|"_")*
WHITESPACE  [ \t]+
LINEBREAK   \n|\r\n

%%

"class"     { count_column(); return CLASS; }
"public"    { count_column(); return PUBLIC; }
"private"   { count_column(); return PRIVATE; }
"protected" { count_column(); return PROTECTED; }
"static"    { count_column(); return STATIC; }
"void"      { count_column(); return VOID; }
"main"      { count_column(); return MAIN; }

"int"       { count_column(); return INT; }
"float"     { count_column(); return FLOAT; }
"double"    { count_column(); return DOUBLE; }
"char"      { count_column(); return CHAR; }
"boolean"   { count_column(); return BOOLEAN; }

"if"        { count_column(); return IF; }
"else"      { count_column(); return ELSE; }
"switch"    { count_column(); return SWITCH; }
"case"      { count_column(); return CASE; }
"default"   { count_column(); return DEFAULT; }
"for"       { count_column(); return FOR; }
"while"     { count_column(); return WHILE; }
"do"        { count_column(); return DO; }
"break"     { count_column(); return BREAK; }
"continue"  { count_column(); return CONTINUE; }
"return"    { count_column(); return RETURN; }

"try"       { count_column(); return TRY; }
"catch"     { count_column(); return CATCH; }
"finally"   { count_column(); return FINALLY; }
"throw"     { count_column(); return THROW; }

"true"      { count_column(); return TRUE_VAL; }
"false"     { count_column(); return FALSE_VAL; }
"null"      { count_column(); return NULL_VAL; }

"System.out.println" { count_column(); return PRINT; }

"+"         { count_column(); return PLUS; }
"-"         { count_column(); return MINUS; }
"*"         { count_column(); return MULTIPLY; }
"/"         { count_column(); return DIVIDE; }
"%"         { count_column(); return MODULO; }

"++"        { count_column(); return INCREMENT; }
"--"        { count_column(); return DECREMENT; }

"="         { count_column(); return ASSIGN; }
"+="        { count_column(); return PLUS_ASSIGN; }
"-="        { count_column(); return MINUS_ASSIGN; }
"*="        { count_column(); return MULTIPLY_ASSIGN; }
"/="        { count_column(); return DIVIDE_ASSIGN; }
"%="        { count_column(); return MODULO_ASSIGN; }

"=="        { count_column(); return EQUAL; }
"!="        { count_column(); return NOT_EQUAL; }
">"         { count_column(); return GREATER; }
"<"         { count_column(); return LESS; }
">="        { count_column(); return GREATER_EQUAL; }
"<="        { count_column(); return LESS_EQUAL; }

"&&"        { count_column(); return AND; }
"||"        { count_column(); return OR; }
"!"         { count_column(); return NOT; }

"("         { count_column(); return LEFT_PAREN; }
")"         { count_column(); return RIGHT_PAREN; }
"{"         { count_column(); return LEFT_BRACE; }
"}"         { count_column(); return RIGHT_BRACE; }
"["         { count_column(); return LEFT_BRACKET; }
"]"         { count_column(); return RIGHT_BRACKET; }
";"         { count_column(); return SEMICOLON; }
","         { count_column(); return COMMA; }
"."         { count_column(); return DOT; }
":"         { count_column(); return COLON; }

{INTEGER}   { 
    count_column(); 
    yylval.int_val = atoi(yytext); 
    return INTEGER_LITERAL; 
}

{FLOAT}|{DOUBLE} { 
    count_column(); 
    yylval.float_val = atof(yytext); 
    return FLOAT_LITERAL; 
}

\'[^\']\' { 
    count_column(); 
    yylval.char_val = yytext[1]; 
    return CHAR_LITERAL; 
}

\"[^\"]*\" { 
    count_column(); 
    // Remove quotes
    yytext[yyleng-1] = '\0';
    yylval.string_val = strdup(yytext+1); 
    return STRING_LITERAL; 
}

{ID}        { 
    count_column(); 
    yylval.id = strdup(yytext); 
    return IDENTIFIER; 
}

{WHITESPACE} { count_column(); }
{LINEBREAK}  { count_line(); }

"//".*      { /* Single line comment */ count_column(); }
"/*"([^*]|"*"+[^*/])*"*"+"/" { /* Multi-line comment */
    for(int i = 0; i < yyleng; i++) {
        if(yytext[i] == '\n') {
            count_line();
        } else {
            column_num++;
        }
    }
}

.           { handle_error(); }

%%

void count_column() {
    column_num += yyleng;
}

void count_line() {
    line_num++;
    column_num = 1;
}

void handle_error() {
    printf("Lexical_Error, %d, %d, Unexpected character: %s\n", line_num, column_num, yytext);
    column_num += yyleng;
}